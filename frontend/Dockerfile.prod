# syntax=docker/dockerfile:1.7
# ─── Etapa 1: builder (Vite con VITE_* horneados) ────────────────────────────
FROM node:24-alpine AS builder

# git: necesario por npm para resolver dependencias `github:` o `git+` (algunos
# paquetes shared-* lo usaron históricamente).
RUN apk add --no-cache git

# Variables horneadas en build. Declararlas como ARG hace que los --build-arg
# del comando docker se propaguen al entorno de Vite (sin esto se ignoran).
ARG VITE_API_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM=maya
ARG VITE_KEYCLOAK_CLIENT_ID=maya-logs
ARG VITE_DASHBOARD_URL
ARG VITE_DASHBOARD_API_URL
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https
ARG VITE_REVERB_APP_KEY

ENV VITE_API_URL=${VITE_API_URL} \
    VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL} \
    VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM} \
    VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID} \
    VITE_DASHBOARD_URL=${VITE_DASHBOARD_URL} \
    VITE_DASHBOARD_API_URL=${VITE_DASHBOARD_API_URL} \
    VITE_REVERB_HOST=${VITE_REVERB_HOST} \
    VITE_REVERB_PORT=${VITE_REVERB_PORT} \
    VITE_REVERB_SCHEME=${VITE_REVERB_SCHEME} \
    VITE_REVERB_APP_KEY=${VITE_REVERB_APP_KEY} \
    NODE_ENV=production

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# ─── Etapa 2: nginx static server ────────────────────────────────────────────
FROM nginx:1.29-alpine AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html

# Config nginx: SPA fallback + caché agresiva para assets fingerprinted.
# Escucha en 8080 para poder correr como non-root (sin CAP_NET_BIND_SERVICE).
# Cabeceras de seguridad: las repetimos en cada location con add_header propio
# porque nginx no hereda add_header al añadirlo en un bloque anidado.
RUN printf 'server {\n\
    listen 8080;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    charset utf-8;\n\
    server_tokens off;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "SAMEORIGIN" always;\n\
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;\n\
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location ~* \\.(js|css|woff|woff2|ttf|eot)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable" always;\n\
        add_header X-Content-Type-Options "nosniff" always;\n\
        add_header X-Frame-Options "SAMEORIGIN" always;\n\
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;\n\
    }\n\
    location ~* \\.(png|jpg|jpeg|gif|ico|svg)$ {\n\
        expires 30d;\n\
        add_header Cache-Control "public" always;\n\
        add_header X-Content-Type-Options "nosniff" always;\n\
        add_header X-Frame-Options "SAMEORIGIN" always;\n\
    }\n\
    location = /healthz {\n\
        access_log off;\n\
        return 200 "ok\\n";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

# Permitir que nginx escriba pid/tmp como non-root.
RUN sed -i '/^user /d' /etc/nginx/nginx.conf \
    && sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html /etc/nginx/conf.d \
    && touch /tmp/nginx.pid && chown nginx:nginx /tmp/nginx.pid

USER nginx

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
