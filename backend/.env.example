APP_NAME="Log Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://${HOST_PREFIX}logs.${DOMAIN_SUFFIX}

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,rabbit
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_RABBIT_LEVEL=warning

# ─── RabbitMQ (broker compartido en maya_infra) ───────────────
RABBITMQ_HOST=maya_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=/${MAYA_SLOT_DB}
MAYA_MESSAGING_APP=maya-logs

# ─── Base de datos (gestionada por infra/) ────────────────────
DB_CONNECTION=pgsql
DB_HOST=maya_infra_postgres
DB_PORT=5432
DB_DATABASE=log_mgmt_db_${MAYA_SLOT_DB}
DB_USERNAME=log_mgmt_user
DB_PASSWORD=secret

# Control de seeders al arrancar (up.sh): always | if-empty | never
DB_SEED_MODE=if-empty

# Conexión Laravel "panel" (config/database.php): usuario PostgreSQL con permisos mínimos.
# Crear el rol con database/sql/setup_panel_user.sql (como superusuario) y NO commitear
# contraseñas reales. Sustituir el placeholder del script antes de ejecutar en producción.
# En desarrollo habitual la app usa DB_USERNAME/DB_PASSWORD; DB_PANEL_* sirve para tests
# de integración (DatabaseConnectionTest) y para despliegues donde el panel use solo panel_user.
DB_PANEL_USERNAME=panel_user
DB_PANEL_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_SECURE_COOKIE: en producción/staging (HTTPS) true; la cookie solo se envía por TLS.
# En local con HTTP, false; si es true el navegador no enviará la cookie.
SESSION_SECURE_COOKIE=false
# SESSION_SAME_SITE: en producción/staging usar strict. En local, lax suele bastar.
SESSION_SAME_SITE=lax
# SESSION_ENCRYPT: en producción/staging con driver database/redis usar true.
# En local, false salvo que se quiera probar cifrado (requiere APP_KEY).
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

# ─── Reverb (WebSockets — notificaciones en tiempo real) ──────
# REVERB_HOST: hostname expuesto al navegador (vía Traefik). En local apunta a
# logs-reverb.${DOMAIN_SUFFIX}. El servidor Reverb escucha en 0.0.0.0:8080
# dentro del contenedor — REVERB_SERVER_HOST/PORT controlan el bind interno.
REVERB_APP_ID=maya-logs
REVERB_APP_KEY=maya-logs-key-change-me
REVERB_APP_SECRET=maya-logs-secret-change-me
REVERB_HOST=${HOST_PREFIX}logs-reverb.${DOMAIN_SUFFIX}
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=maya_redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VIEW_COMPILED_PATH=/tmp/laravel-views

# ─── JWT / JWKS (maya-shared-auth-laravel) ────────────────────
JWKS_URL=http://maya_auth_keycloak:8080/realms/${MAYA_SLOT}/protocol/openid-connect/certs
JWT_ISSUER=https://keycloak.${DOMAIN_SUFFIX}/realms/${MAYA_SLOT}
# JWT_AUDIENCE: vacío para aceptar tokens de cualquier client del realm
JWT_AUDIENCE=
JWKS_CACHE_TTL=3600

# ─── Puertos (acceso directo sin Traefik) ─────────────────────
BACKEND_PORT=8002
VITE_PORT=5176

# ─── Slot context (materializadas por envsubst en up-common.sh) ───────────────
MAYA_SLOT=${MAYA_SLOT}
MAYA_SLOT_DB=${MAYA_SLOT_DB}
HOST_PREFIX=${HOST_PREFIX}
DOMAIN_SUFFIX=${DOMAIN_SUFFIX}

# ─── Error Spike Detection (Scheduled Notifications) ──────────
# Window in seconds to analyze for critical/high severity logs (default: 60 = 1 minute)
LOGS_ERROR_SPIKE_WINDOW_SECONDS=60
# Threshold count: alert published when count >= this value in the window (default: 10)
LOGS_ERROR_SPIKE_THRESHOLD=10
